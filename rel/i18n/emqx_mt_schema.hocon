emqx_mt_schema {
    config {
        desc: "Multi-tenancy configuration"
        label: "Multi-tenancy"
    }
    default_max_sessions {
        desc: """~
            The default number of live sessions allowed for each namespace.
            Access will be denied for new clients if limit is reached.
            Online config changes do not affect running sessions.~"""
        label: "Default Max Number of Sessions"
    }
    allow_only_managed_namespaces {
        desc: """~
            If enabled, clients that belong to a non-managed namespace will be
            denied connection.  Clients that can't have their namespace resolved
            will also be denied connection.~"""
        label: "Allow only managed namespaces"
    }
    post_auth_tns_expression {
        desc: """~
            An expression that is evaluated after the authentication chain completes,
            and whose rendered value is written back into `client_attrs.tns`, the
            tenant namespace key used by multi-tenancy quota and routing decisions.
            Leave empty to disable (default). When empty, multi-tenancy resolves
            `tns` only from `mqtt.client_attrs_init` (evaluated before authentication).
            When configured, the expression can reference bindings available to
            `mqtt.client_attrs_init` (for example, <code>username</code>,
            <code>clientid</code>, and <code>cert_common_name</code>) plus
            <code>client_attrs.*</code>. When <code>require_trusted_attributes</code> is
            enabled, the expression can access only trusted bindings. Example:
            <code>client_attrs.tag</code> makes the multi-tenancy
            app treat an auth-server-supplied <code>tag</code> attribute as the
            tenant namespace. Example with fallback:
            <code>coalesce(client_attrs.tag, username)</code>.
            If the expression renders to an empty string or returns an error, a
            warning is logged and the client is treated as having no <code>tns</code>.
            Names listed in <code>deny_namespaces</code> cannot be used as a
            namespace; a client resolving to one of them is rejected.~"""
        label: "Post-authentication tns expression"
    }
    require_trusted_attributes {
        desc: """~
            Use only trusted client attributes for namespace resolution, managed namespace
            checks, and quota checks. The default is `false` for the legacy security profile
            and `true` for the hardened security profile.~"""
        label: "Require Trusted Attributes"
    }
    deny_namespaces {
        desc: """~
            Namespace names that cannot be used as a namespace identifier —
            neither as an admin namespace (dashboard roles, API keys,
            multi-tenancy management API) nor as a per-client
            <code>client_attrs.tns</code>; a client whose <code>tns</code>
            resolves to a denied name is rejected. The default entries collide
            with internal sentinels and would produce ambiguous log lines and
            dashboard output. Set to an empty list to disable the restriction.~"""
        label: "Denied namespace names"
    }
}
